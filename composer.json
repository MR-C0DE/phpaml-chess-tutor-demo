{
    "name": "phpaml/phpaml",
    "description": "Micro-framework MVC inspiré d'ASP.NET et Java EE",
    "license": "proprietary",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "phpaml/data": "^0.1@alpha",
        "phpaml/data-mongodb": "^0.1@alpha",
        "phpaml/engine": "^0.1@beta",
        "phpaml/view": "^0.1.0-beta.3"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "PHPAML\\": "runtime/framework/",
            "App\\": "src/",
            "App\\Views\\": "src/views/",
            "App\\Views\\Pages\\": "src/views/pages/",
            "App\\Views\\Components\\": "src/views/components/",
            "App\\Views\\Layouts\\": "src/views/layouts/",
            "App\\Views\\States\\": "src/views/states/",
            "App\\Controllers\\": "src/controllers/",
            "App\\Models\\": "src/models/",
            "App\\Middleware\\": "src/middleware/",
            "App\\Services\\": "src/services/"
        }
    },
    "config": {
        "vendor-dir": "runtime",
        "sort-packages": true
    },
    "scripts": {
        "test": "php tests/run.php",
        "analyse": "phpstan analyse"
    }
}
